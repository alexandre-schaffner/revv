{
  "links": [
    {
      "title": "Sessions",
      "type": "link",
      "url": "/d/revv-overview?${__url_time_range}"
    },
    {
      "title": "Profiles",
      "type": "link",
      "url": "/d/revv-profiles?${__url_time_range}"
    }
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": ["revv", "observability"],
  "timezone": "browser",
  "refresh": "",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "uid": "revv-trace",
  "title": "Revv trace",
  "description": "Trace waterfall including MCP calls and session-correlated native agent spans. Original trace IDs are retained in span tags.",
  "templating": {
    "list": [
      {
        "name": "traceId",
        "label": "Trace ID",
        "type": "textbox",
        "current": {
          "text": "select-a-trace",
          "value": "select-a-trace"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 14,
      "title": "Trace waterfall",
      "type": "traces",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 20
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "revv-sessions"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "revv-sessions"
          },
          "type": "json",
          "parser": "jq-backend",
          "source": "url",
          "format": "trace",
          "url": "http://host.docker.internal:45680/api/trace/${traceId:percentencode}",
          "url_options": {
            "method": "GET"
          },
          "root_selector": "map({traceID: \"${traceId}\", spanID: .spanId, parentSpanID: (.parentSpanId // \"\"), startTime: .startMs, duration: .durationMs, serviceName: .serviceName, operationName: .name, statusCode: .statusCode, statusMessage: .statusMessage, tags: ((.attributes + {\"original.trace_id\": .traceId}) | to_entries)})",
          "columns": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "—",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Errors"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Spans"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "P50"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "P95"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "traceId"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open trace",
                    "targetBlank": false,
                    "url": "/d/revv-trace/revv-trace?var-traceId=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "P50"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "P95"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Error rate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          }
        ]
      },
      "options": {},
      "transformations": [
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "tags",
                "destinationType": "other"
              }
            ]
          }
        }
      ]
    },
    {
      "id": 15,
      "title": "Span details",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "revv-sessions"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "revv-sessions"
          },
          "type": "json",
          "parser": "jq-backend",
          "source": "url",
          "format": "table",
          "url": "http://host.docker.internal:45680/api/trace/${traceId:percentencode}",
          "url_options": {
            "method": "GET"
          },
          "root_selector": ".",
          "columns": [
            {
              "selector": "spanId",
              "text": "Span ID",
              "type": "string"
            },
            {
              "selector": "traceId",
              "text": "traceId",
              "type": "string"
            },
            {
              "selector": "name",
              "text": "Operation",
              "type": "string"
            },
            {
              "selector": "serviceName",
              "text": "Service",
              "type": "string"
            },
            {
              "selector": "startMs",
              "text": "Started",
              "type": "timestamp_epoch"
            },
            {
              "selector": "durationMs",
              "text": "Duration",
              "type": "number"
            },
            {
              "selector": "statusMessage",
              "text": "Error",
              "type": "string"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "—",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Errors"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Spans"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "P50"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "P95"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "traceId"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open trace",
                    "targetBlank": false,
                    "url": "/d/revv-trace/revv-trace?var-traceId=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "P50"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "P95"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Error rate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "P95",
            "desc": true
          }
        ]
      }
    }
  ]
}
