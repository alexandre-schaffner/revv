# Revv — Environment Variables
# Copy this file to .env and fill in your values.
# Bun automatically loads .env files.

# Optional
REVV_DB_PATH=./revv.db   # Custom database file path
REV_DEBUG=false           # Enable debug logging

# Optional: export spans to the local Revv telemetry collector (auto-set by `make dev-desktop`)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:45680
