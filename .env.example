# Revv — Environment Variables
# Copy this file to .env and fill in your values.
# Bun automatically loads .env files.

# Optional
REVV_DB_PATH=./revv.db   # Custom database file path
REV_DEBUG=false           # Enable debug logging

# Optional: export spans to the local Revv telemetry collector (auto-set by `make dev-desktop`)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:45680
# Collector retention for weekly trace reviews (row cap can prune earlier).
# COLLECTOR_RETENTION_DAYS=14
# COLLECTOR_MAX_SPANS=1000000
# COLLECTOR_DB_PATH=/absolute/path/to/collector.duckdb
# Claude ACP exports native model/tool spans automatically when an endpoint is set.
# Explicit CLAUDE_CODE_ENABLE_TELEMETRY=0 or OTEL_TRACES_EXPORTER=none opts out.

# Continuous Bun CPU stacks in the local Pyroscope/Grafana stack (opt-in).
# REVV_PYROSCOPE_ENDPOINT=http://127.0.0.1:4040
