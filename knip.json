{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.ts"],
      "ignoreDependencies": ["@tauri-apps/cli", "concurrently"]
    },
    "apps/web": {
      "entry": [
        "src/routes/**/+{page,layout,server,error,page.load,layout.load}.svelte",
        "src/routes/**/+{page,layout}.ts",
        "src/**/*.test.ts",
        "src/app.html",
        "src/app.d.ts",
        "src/hooks.server.ts",
        "src/hooks.client.ts",
        "svelte.config.js",
        "vite.config.ts",
        "static/**"
      ],
      "ignoreDependencies": [
        "@sveltejs/adapter-static",
        "@sveltejs/kit",
        "@sveltejs/vite-plugin-svelte",
        "@tailwindcss/vite",
        "svelte-check",
        "mode-watcher",
        "svelte-sonner",
        "bun-types"
      ]
    },
    "apps/server": {
      "entry": ["src/index.ts", "src/**/*.test.ts"],
      "ignoreDependencies": ["bun-types", "drizzle-kit"]
    },
    "apps/collector": {
      "entry": [
        "src/index.ts",
        "web/vite.config.ts",
        "web/svelte.config.js",
        "web/src/main.ts",
        "web/src/vite-env.d.ts"
      ],
      "ignoreDependencies": [
        "@sveltejs/vite-plugin-svelte",
        "@tailwindcss/vite",
        "bun-types",
        "svelte-check",
        "tailwindcss"
      ]
    },
    "packages/shared": {
      "entry": ["src/index.ts"]
    }
  },
  "ignore": [
    ".context/**",
    "apps/server/src/cache/CacheLayer.ts",
    "apps/server/src/cache/Key.ts",
    "apps/server/src/cache/backends/**",
    "apps/server/src/cache/policies/**"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": ["biome", "turbo", "knip"]
}
