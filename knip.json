{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.ts"]
    },
    "apps/web": {
      "entry": [
        "src/routes/**/+{page,layout,server,error,page.load,layout.load}.svelte",
        "src/routes/**/+{page,layout}.ts",
        "src/app.html",
        "static/**"
      ],
      "ignore": [
        "src/lib/components/ai/**",
        "src/lib/constants.ts",
        "src/lib/services/**",
        "src/lib/stores/**",
        "src/lib/utils/**"
      ]
    },
    "apps/server": {
      "ignore": [
        "src/ai/**",
        "src/cache/**",
        "src/config.ts",
        "src/constants.ts",
        "src/domain/errors.ts",
        "src/logger.ts",
        "src/services/GitOps.ts",
        "src/services/OpencodeSupervisor.ts"
      ]
    },
    "packages/shared": {},
    "packages/ui": {
      "entry": ["src/**/*.{ts,tsx}"]
    },
    "packages/app": {
      "entry": ["src/routes/**/*.{ts,tsx}"],
      "ignoreDependencies": ["tailwindcss"],
      "ignore": ["src/lib/**"]
    }
  },
  "ignore": [
    "apps/web/src/lib/components/layout/BlockedStrip.svelte",
    "apps/web/src/lib/components/layout/ChatInputArea.svelte",
    "apps/web/src/lib/components/layout/ChatTimeline.svelte",
    "apps/web/src/lib/components/layout/ProposedChangesDock.svelte",
    "apps/web/src/lib/components/layout/PushDialogs.svelte",
    "apps/web/src/lib/components/recaps/RecapPeriodPage.svelte",
    "apps/web/src/lib/components/sidebar/RepoRecapsSubsection.svelte"
  ],
  "ignoreExportsUsedInFile": true
}
