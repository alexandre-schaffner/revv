{
  "name": "revv",
  "private": true,
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "./scripts/prepare-effect.sh",
    "dev": "bun run observability:up && turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p scripts/performance/tsconfig.json",
    "lint": "biome ci . && bun run check:import-boundaries && bun run check:pr-deep-links && bun run check:external-agents && bun run check:migrations",
    "check:import-boundaries": "bun scripts/check-import-boundaries.ts",
    "check:pr-deep-links": "bun scripts/check-pr-deep-link-contract.ts",
    "check:external-agents": "bun scripts/check-external-agent-contract.ts",
    "check:migrations": "bun scripts/check-migrations.ts && cd apps/server && bun test src/db/migration",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "knip": "knip",
    "dev:web": "cd apps/web && bun run dev",
    "dev:server": "cd apps/server && bun run dev",
    "dev:collector": "bun scripts/dev-collector.ts",
    "dev:desktop": "bun run observability:up && concurrently --kill-others --names collector,web,server,tauri -c magenta,green,yellow,blue \"bun run dev:collector\" \"bun run dev:web\" \"bun run dev:server\" \"sleep 3 && cd apps/desktop && bunx tauri dev --config tauri.dev.conf.json\"",
    "dist": "cd apps/desktop && bunx tauri build",
    "dist:debug": "cd apps/desktop && bunx tauri build --debug",
    "clean": "rm -rf apps/web/build apps/web/.svelte-kit apps/server/dist apps/desktop/target .turbo",
    "postinstall": "echo $'\\n  Run `bun run dev` to start developing, or `bun run dist` to build an installer.\\n'",
    "perf:install": "bun --no-env-file scripts/performance/install-machine.ts",
    "perf:review": "bun --no-env-file scripts/performance/review.ts",
    "perf:bench": "bun --no-env-file scripts/performance/benchmark.ts",
    "perf:profile": "bun --no-env-file scripts/performance/profile.ts",
    "perf:compare": "bun --no-env-file scripts/performance/compare.ts",
    "perf:test": "bun test scripts/performance",
    "observability:check": "bun scripts/verify-grafana.mjs",
    "observability:up": "bun scripts/observability.ts up",
    "observability:down": "bun scripts/observability.ts down"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@effect/language-service": "^0.87.3",
    "@tauri-apps/cli": "^2.12.0",
    "bun-types": "1.4.2",
    "concurrently": "^10.0.5",
    "knip": "^6.38.0",
    "turbo": "^2.11.5",
    "typescript": "^6.0.3"
  },
  "dependencies": {}
}
