{
  "name": "@revv/collector",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun ../../scripts/dev-collector.ts",
    "build": "bun build src/index.ts --outdir dist --target bun --external @duckdb/node-api",
    "typecheck": "tsc --noEmit",
    "start": "bun run src/index.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.3-r.3",
    "@elysiajs/cors": "^1",
    "@revv/shared": "workspace:*",
    "elysia": "^1"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "typescript": "^5.7.0"
  }
}
