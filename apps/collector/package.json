{
  "name": "@revv/collector",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./web/tsconfig.json",
    "start": "bun run src/index.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.3-r.3",
    "@elysiajs/cors": "^1",
    "@revv/shared": "workspace:*",
    "elysia": "^1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5",
    "@tailwindcss/vite": "^4",
    "bun-types": "^1.3.14",
    "phosphor-svelte": "^3.1.0",
    "svelte": "^5",
    "svelte-check": "^4",
    "svelteplot": "^0.14.2",
    "typescript": "^5.7.0",
    "vite": "^6"
  }
}
