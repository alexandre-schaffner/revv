{
  "$schema": "https://raw.githubusercontent.com/nickel-org/nickel.rs/refs/heads/master/nickel/tauri-schema.json",
  "productName": "Revv (Alpha)",
  "identifier": "com.revv.desktop",
  "version": "0.19.3",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../web/build",
    "beforeBuildCommand": "",
    "beforeDevCommand": ""
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "DeveloperTool",
    "shortDescription": "AI-powered code review",
    "longDescription": "Revv is a desktop application that brings AI-powered intelligence to your code review workflow. Review pull requests with AI assistance, inline comments, and smart suggestions.",
    "copyright": "Copyright 2025 Revv contributors",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Revv (Alpha)",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:45678 http://localhost:45679 ws://localhost:45678 ws://localhost:45679 ws://localhost:9223; frame-src artifact:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:"
    }
  },
  "plugins": {
    "deep-link": {
      "enable": true
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/alexandre-schaffner/revv/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "REPLACE_WITH_MINISIGN_PUBLIC_KEY"
    }
  }
}
