#!/usr/bin/env bash
# ──────────────────────────────────────────────────────────────
# revv — Management CLI for a Revv source install
#
# Installed by install.sh to ~/.local/bin/revv.
# Drives the source tree at ~/Library/Application Support/Revv/src
# and the LaunchAgent at ~/Library/LaunchAgents/com.revv.server.plist.
#
# Commands:
#   revv update      Pull latest on the configured channel, rebuild, reinstall
#   revv channel     Print or change the release channel (stable | nightly)
#   revv uninstall   Remove ALL Revv artifacts (app, data, config, services, CLI)
#   revv start       Load + start the server LaunchAgent
#   revv stop        Unload + stop the server LaunchAgent
#   revv restart     Stop + start
#   revv status      Show versions, install paths, server state
#   revv logs        Tail the server logs
#   revv open        Open Revv.app
#   revv doctor      Run a set of health checks
#   revv path        Print paths used by this install
#   revv help        Show this message
# ──────────────────────────────────────────────────────────────
set -euo pipefail

CONFIG_FILE="$HOME/Library/Application Support/Revv/config"
INSTALL_DIR="${REVV_INSTALL_DIR:-$HOME/Library/Application Support/Revv/src}"
# Glob `Revv*.app` so we find the actual bundle regardless of productName
# ("Revv.app" vs "Revv (Alpha).app", etc.). CONFIG_FILE's APP_PATH — written
# by install.sh with the exact path it just copied — is prepended below and
# takes precedence for normal installs.
APP_CANDIDATES=()
for __dir in "/Applications" "$HOME/Applications"; do
  for __app in "$__dir"/Revv*.app; do
    [[ -d "$__app" ]] && APP_CANDIDATES+=("$__app")
  done
done
unset __dir __app
LAUNCH_AGENT_LABEL="com.revv.server"
LAUNCH_AGENT_PLIST="$HOME/Library/LaunchAgents/$LAUNCH_AGENT_LABEL.plist"
LOG_DIR="$HOME/Library/Logs/Revv"
CLI_PATH="$HOME/.local/bin/revv"
API_URL="http://localhost:45678"

# Override defaults with values persisted by the installer.
if [[ -f "$CONFIG_FILE" ]]; then
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"
  [[ -n "${SOURCE_DIR:-}" ]] && INSTALL_DIR="$SOURCE_DIR"
  [[ -n "${APP_PATH:-}" && -d "$APP_PATH" ]] && APP_CANDIDATES=("$APP_PATH" "${APP_CANDIDATES[@]}")
fi

# ── Load shared helpers ───────────────────────────────────────
# Prefer the copy shipped alongside this CLI (~/.local/share/revv/common.sh).
# Fall back to the one in the source tree for in-checkout invocations. If
# neither is available, define just enough inline helpers to keep the CLI
# working (useful if the user copied just the `revv` binary to a new machine).
__revv_lib_paths=(
  "$HOME/.local/share/revv/common.sh"
  "$INSTALL_DIR/scripts/lib/common.sh"
  "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/lib/common.sh"
)
__revv_lib_loaded=0
for __lib in "${__revv_lib_paths[@]}"; do
  if [[ -f "$__lib" ]]; then
    # shellcheck disable=SC1090
    source "$__lib"
    __revv_lib_loaded=1
    break
  fi
done

if [[ "$__revv_lib_loaded" -eq 0 ]]; then
  # Inline fallbacks. Keep these in sync with scripts/lib/common.sh.
  if [[ -t 1 ]]; then
    RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'
    BLUE=$'\033[0;34m'; CYAN=$'\033[0;36m'; BOLD=$'\033[1m'
    DIM=$'\033[2m'; RESET=$'\033[0m'
  else
    RED=""; GREEN=""; YELLOW=""; BLUE=""; CYAN=""; BOLD=""; DIM=""; RESET=""
  fi
  info()    { printf "  %s·%s  %s\n"     "$CYAN"   "$RESET" "$*"; }
  success() { printf "  %s✓%s  %s\n"     "$GREEN"  "$RESET" "$*"; }
  warn()    { printf "  %s⚠%s  %s\n"     "$YELLOW" "$RESET" "$*"; }
  fail()    { printf "\n  %s✗%s  %s\n\n" "$RED"    "$RESET" "$*" >&2; exit 1; }
  step()    { printf "\n  %s%s▸%s  %s\n\n" "$BOLD" "$CYAN" "$RESET" "$*"; }
  confirm() {
    if [[ "${REVV_AUTO_YES:-0}" == "1" ]]; then return 0; fi
    local reply
    printf "  %s→%s  %s [y/N] " "$YELLOW" "$RESET" "$1"
    read -r reply </dev/tty || read -r reply
    [[ "$reply" =~ ^[Yy] ]]
  }
  _REVV_SP_FRAMES='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
  _REVV_SP_MSG=''; _REVV_SP_PID=''
  spin_start() {
    _REVV_SP_MSG="$1"
    if [[ ! -t 1 ]]; then printf "  ···  %s\n" "$_REVV_SP_MSG"; return; fi
    printf '\033[?25l'
    ( local i=0
      while true; do
        printf "\r  %s%s%s  %s  " "$CYAN" "${_REVV_SP_FRAMES:$((i%10)):1}" "$RESET" "$_REVV_SP_MSG"
        i=$((i+1)); sleep 0.07
      done ) &
    _REVV_SP_PID=$!; disown "$_REVV_SP_PID" 2>/dev/null
  }
  spin_stop() {
    local ok="${1:-1}"
    if [[ -n "$_REVV_SP_PID" ]]; then
      kill "$_REVV_SP_PID" 2>/dev/null; wait "$_REVV_SP_PID" 2>/dev/null; _REVV_SP_PID=''
    fi
    if [[ ! -t 1 ]]; then return; fi
    printf '\033[?25h'
    if [[ "$ok" -eq 1 ]]; then printf "\r  %s✓%s  %-50s\n" "$GREEN" "$RESET" "$_REVV_SP_MSG"
    else                        printf "\r  %s✗%s  %-50s\n" "$RED"   "$RESET" "$_REVV_SP_MSG"; fi
  }
  banner() {
    printf "\n"
    printf "  %s%s██████╗ ███████╗██╗   ██╗██╗   ██╗%s\n" "$CYAN" "$BOLD" "$RESET"
    printf "  %s%s██╔══██╗██╔════╝██║   ██║██║   ██║%s\n" "$CYAN" "$BOLD" "$RESET"
    printf "  %s%s██████╔╝█████╗  ██║   ██║██║   ██║%s\n" "$CYAN" "$BOLD" "$RESET"
    printf "  %s%s██╔══██╗██╔══╝  ╚██╗ ██╔╝╚██╗ ██╔╝%s\n" "$CYAN" "$BOLD" "$RESET"
    printf "  %s%s██║  ██║███████╗ ╚████╔╝  ╚████╔╝ %s\n"  "$CYAN" "$BOLD" "$RESET"
    printf "  %s%s╚═╝  ╚═╝╚══════╝  ╚═══╝    ╚═══╝  %s\n" "$CYAN" "$BOLD" "$RESET"
    printf "\n  %sAI-powered code review%s\n\n" "$DIM" "$RESET"
  }
fi

# Canonical paths (auth key, support dir, etc.)
REVV_SUPPORT_DIR="${REVV_SUPPORT_DIR:-$HOME/Library/Application Support/Revv}"
REVV_AUTH_KEY="${REVV_AUTH_KEY:-$REVV_SUPPORT_DIR/auth.key}"

find_app() {
  for p in "${APP_CANDIDATES[@]}"; do
    [[ -d "$p" ]] && { printf "%s" "$p"; return 0; }
  done
  return 1
}

ensure_install_dir() {
  [[ -d "$INSTALL_DIR/.git" ]] || fail "No Revv source install found at $INSTALL_DIR.
Run the installer first:
  curl -fsSL https://raw.githubusercontent.com/alexandre-schaffner/revv/main/install.sh | bash"
}

load_bun_path() {
  # NOTE: use `if` rather than `&&` chains so a false condition on the last
  # line doesn't make the function return non-zero — that would trip `set -e`
  # at the call site and exit the script silently (e.g. when Rust is installed
  # via Homebrew instead of rustup, so ~/.cargo/env doesn't exist).
  if [[ -d "$HOME/.bun/bin" ]]; then
    export PATH="$HOME/.bun/bin:$PATH"
  fi
  if [[ -f "$HOME/.cargo/env" ]]; then
    # shellcheck disable=SC1091
    source "$HOME/.cargo/env"
  fi
}

server_running() {
  # Port check — more reliable than launchctl state
  nc -z 127.0.0.1 45678 >/dev/null 2>&1
}

# ── Channel helpers ─────────────────────────────────────────────────────
# SQLite is the source of truth for `update_channel`. The server writes
# through to it inside `SettingsService.updateSettings`, so a read of the
# column always reflects the latest committed state. Reads skip the API
# entirely; writes go through the API so the in-memory `SubscriptionRef`
# cache that drives the web app stays consistent.
read_channel() {
  command -v sqlite3 >/dev/null 2>&1 || \
    fail "sqlite3 not found — install it (e.g. 'brew install sqlite') and retry."
  [[ -f "$INSTALL_DIR/revv.db" ]] || \
    fail "Revv database missing at $INSTALL_DIR/revv.db. Run 'revv start' to initialize it."
  local v
  v="$(sqlite3 "$INSTALL_DIR/revv.db" \
    "SELECT update_channel FROM user_settings WHERE id='default';" 2>/dev/null)"
  case "$v" in nightly) printf "nightly" ;; *) printf "stable" ;; esac
}

# Send a channel change through the running server. Going through the API
# (instead of writing the column directly) keeps the in-memory
# `SettingsService` cache consistent so the web app sees the new value
# without a server restart.
write_channel() {
  local target="$1"
  server_running || fail "Revv server is not running.
Start it with 'revv start', then re-run 'revv channel $target'."
  curl -fsS -X PUT "$API_URL/api/update-channel" \
    -H 'Content-Type: application/json' \
    -d "{\"channel\":\"$target\"}" >/dev/null 2>&1 || \
    fail "Failed to update channel via $API_URL/api/update-channel."
}

# Resolve the git ref that `cmd_update` should fast-forward to. `stable`
# pins to the latest `v*` tag reachable from origin/main (release-please's
# semver tag); `nightly` rides origin/main HEAD. The caller is responsible
# for having already fetched, so this never touches the network.
resolve_target_ref() {
  case "$1" in
    nightly) printf "origin/main" ;;
    stable)
      local tag
      tag="$(git -C "$INSTALL_DIR" describe --tags --abbrev=0 --match='v*' \
        origin/main 2>/dev/null)" || tag=""
      printf "%s" "${tag:-origin/main}"
      ;;
    *) fail "Invalid channel: $1" ;;
  esac
}

# ── Commands ─────────────────────────────────────────────────

cmd_help() {
  cat <<EOF
${BOLD}revv${RESET} — manage your Revv source install.

${BOLD}Usage:${RESET}
  revv <command>

${BOLD}Commands:${RESET}
  ${CYAN}update${RESET}      Pull latest on the configured channel, rebuild, reinstall
              ${DIM}flags: --channel <stable|nightly> (one-shot, doesn't persist)${RESET}
  ${CYAN}channel${RESET}     Print or change the release channel (stable | nightly)
  ${CYAN}uninstall${RESET}   Remove ALL Revv artifacts (app, data, config, services, CLI)
  ${CYAN}start${RESET}       Start the background API server
  ${CYAN}stop${RESET}        Stop the background API server
  ${CYAN}restart${RESET}     Restart the background API server
  ${CYAN}status${RESET}      Show install paths, versions, and server state
  ${CYAN}logs${RESET}        Tail the server log files
  ${CYAN}open${RESET}        Launch Revv.app
  ${CYAN}doctor${RESET}      Run health checks
  ${CYAN}path${RESET}        Print the paths this install uses
  ${CYAN}help${RESET}        Show this message
EOF
}

cmd_path() {
  local tauri_id="com.revv.desktop"
  cat <<EOF
${BOLD}Install${RESET}
  Source:          $INSTALL_DIR
  App:             $(find_app || printf "(not installed)")
  CLI:             $CLI_PATH
  Helper lib:      $HOME/.local/share/revv/common.sh

${BOLD}Data${RESET}
  Database:        $INSTALL_DIR/revv.db
  Git clones:      $HOME/.revv/repos/
  Settings:        $HOME/.revv/settings.json
  Auth key:        $REVV_AUTH_KEY
  GitHub config:   $REVV_SUPPORT_DIR/github.conf

${BOLD}Services${RESET}
  Server agent:    $LAUNCH_AGENT_PLIST
  Autostart agent: $HOME/Library/LaunchAgents/${tauri_id}.plist
  Logs:            $LOG_DIR

${BOLD}Tauri / WebView${RESET}
  WebKit data:     $HOME/Library/WebKit/$tauri_id/
  App support:     $HOME/Library/Application Support/$tauri_id/
  Saved state:     $HOME/Library/Saved Application State/${tauri_id}.savedState/
  Caches:          $HOME/Library/Caches/$tauri_id/
  Preferences:     $HOME/Library/Preferences/${tauri_id}.plist
EOF
}

cmd_start() {
  [[ -f "$LAUNCH_AGENT_PLIST" ]] || fail "LaunchAgent missing at $LAUNCH_AGENT_PLIST. Re-run the installer."
  launchctl load -w "$LAUNCH_AGENT_PLIST" 2>/dev/null || true
  sleep 1
  if server_running; then success "Server is running on $API_URL"; else warn "Server did not come up — check 'revv logs'"; fi
}

cmd_stop() {
  launchctl unload -w "$LAUNCH_AGENT_PLIST" 2>/dev/null || true
  sleep 1
  if server_running; then warn "Server still responds — another process may be on port 45678"; else success "Server stopped"; fi
}

cmd_restart() {
  cmd_stop
  cmd_start
}

cmd_status() {
  step "Revv install status"
  ensure_install_dir 2>/dev/null || { warn "Source not found at $INSTALL_DIR"; return 0; }

  local commit branch
  commit="$(git -C "$INSTALL_DIR" rev-parse --short HEAD 2>/dev/null || echo unknown)"
  branch="$(git -C "$INSTALL_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)"
  printf "  %sSource:%s      %s\n" "$BOLD" "$RESET" "$INSTALL_DIR"
  printf "  %sBranch:%s      %s @ %s\n" "$BOLD" "$RESET" "$branch" "$commit"

  if app="$(find_app)"; then
    local ver
    ver="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$app/Contents/Info.plist" 2>/dev/null || echo "?")"
    printf "  %sApp:%s         %s (v%s)\n" "$BOLD" "$RESET" "$app" "$ver"
  else
    printf "  %sApp:%s         %s(not installed)%s\n" "$BOLD" "$RESET" "$RED" "$RESET"
  fi

  if [[ -f "$LAUNCH_AGENT_PLIST" ]]; then
    local pid
    pid="$(launchctl list 2>/dev/null | awk -v lbl="$LAUNCH_AGENT_LABEL" '$3 == lbl {print $1}')"
    if [[ -n "$pid" && "$pid" != "-" ]]; then
      printf "  %sService:%s     running (pid %s)\n" "$BOLD" "$RESET" "$pid"
    else
      printf "  %sService:%s     loaded but not running\n" "$BOLD" "$RESET"
    fi
  else
    printf "  %sService:%s     %snot installed%s\n" "$BOLD" "$RESET" "$RED" "$RESET"
  fi

  if server_running; then
    printf "  %sAPI:%s         %sresponding on %s%s\n" "$BOLD" "$RESET" "$GREEN" "$API_URL" "$RESET"
  else
    printf "  %sAPI:%s         %snot responding on %s%s\n" "$BOLD" "$RESET" "$RED" "$API_URL" "$RESET"
  fi

  # Upstream check
  if git -C "$INSTALL_DIR" fetch --quiet 2>/dev/null; then
    local behind
    behind="$(git -C "$INSTALL_DIR" rev-list --count "HEAD..@{upstream}" 2>/dev/null || echo 0)"
    if [[ "$behind" -gt 0 ]]; then
      printf "  %sUpdate:%s      %s%d commit(s) behind — run 'revv update'%s\n" "$BOLD" "$RESET" "$YELLOW" "$behind" "$RESET"
    else
      printf "  %sUpdate:%s      up to date\n" "$BOLD" "$RESET"
    fi
  fi
}

cmd_logs() {
  [[ -d "$LOG_DIR" ]] || fail "No log directory at $LOG_DIR"
  local files=()
  [[ -f "$LOG_DIR/server.err.log" ]] && files+=("$LOG_DIR/server.err.log")
  [[ -f "$LOG_DIR/server.out.log" ]] && files+=("$LOG_DIR/server.out.log")
  [[ ${#files[@]} -gt 0 ]] || fail "No log files yet. Start the server with 'revv start'."
  printf "%sTailing %s%s — Ctrl-C to exit%s\n" "$DIM" "${files[*]}" "" "$RESET"
  tail -F "${files[@]}"
}

cmd_open() {
  local app
  app="$(find_app)" || fail "Revv.app not found. Run 'revv update' or reinstall."
  open "$app"
}

cmd_update() {
  # Single-flag parser: `--channel <stable|nightly>` overrides the
  # persisted channel for this invocation only (no setting write).
  local channel_override=""
  case "${1:-}" in
    --channel)    channel_override="${2:-}"; shift 2 || true ;;
    --channel=*)  channel_override="${1#--channel=}"; shift ;;
    "")           ;;
    *)            fail "Unknown argument to 'revv update': $1" ;;
  esac
  case "$channel_override" in
    ""|stable|nightly) ;;
    *) fail "Invalid --channel value: $channel_override (expected stable|nightly)" ;;
  esac

  ensure_install_dir
  load_bun_path
  banner
  printf "  %s──────────────────────────────────────────────────────%s\n\n" "$DIM" "$RESET"

  local channel
  if [[ -n "$channel_override" ]]; then
    channel="$channel_override"
    info "Channel: ${channel} ${DIM}(one-shot override; persisted channel unchanged)${RESET}"
  else
    channel="$(read_channel)"
    info "Channel: ${channel}"
  fi

  # ── Fetch ─────────────────────────────────────────────────
  spin_start "Fetching latest from origin…"
  git -C "$INSTALL_DIR" fetch --all --prune --tags >/dev/null 2>&1 || true
  spin_stop 1

  local target_ref
  target_ref="$(resolve_target_ref "$channel")"
  info "Target ref: ${target_ref}"

  local before after
  before="$(git -C "$INSTALL_DIR" rev-parse HEAD)"
  git -C "$INSTALL_DIR" reset --hard "$target_ref" >/dev/null 2>&1 || \
    fail "Failed to fast-forward to $target_ref. Run 'git -C \"$INSTALL_DIR\" fetch' and retry."
  after="$(git -C "$INSTALL_DIR" rev-parse HEAD)"

  if [[ "$before" == "$after" ]]; then
    info "Already up to date ($(git -C "$INSTALL_DIR" rev-parse --short HEAD))"
    if ! confirm "Force a rebuild anyway?"; then
      success "Nothing to do."
      return 0
    fi
  else
    local short_before short_after
    short_before="$(git -C "$INSTALL_DIR" rev-parse --short "$before")"
    short_after="$(git -C "$INSTALL_DIR" rev-parse --short "$after")"
    info "Updated ${short_before} → ${short_after}"
    git -C "$INSTALL_DIR" --no-pager log --oneline "$before..$after" | \
      while IFS= read -r line; do
        printf "    %s%s%s\n" "$DIM" "$line" "$RESET"
      done
    printf "\n"
  fi

  # ── Dependencies ──────────────────────────────────────────
  step "Dependencies"
  (cd "$INSTALL_DIR" && bun install)

  # ── Build ─────────────────────────────────────────────────
  step "Build"
  (cd "$INSTALL_DIR" && make dist)

  # Find the newly built .app.
  local bundle_app app_name
  bundle_app="$(find "$INSTALL_DIR/apps/desktop/target/release/bundle/macos" -maxdepth 1 -type d -name '*.app' 2>/dev/null | head -1)"
  if [[ -z "$bundle_app" ]]; then
    bundle_app="$(find "$INSTALL_DIR/apps/desktop/target" -maxdepth 6 -type d -name '*.app' -path '*/bundle/macos/*' 2>/dev/null | head -1)"
  fi
  [[ -d "$bundle_app" ]] || fail "Build finished but no .app bundle was produced."
  app_name="$(basename "$bundle_app")"

  # Determine install destination.
  local dest_app dest_dir old_app
  old_app="$(find_app)" || old_app=""
  if [[ -n "$old_app" ]]; then
    dest_dir="$(dirname "$old_app")"
  else
    dest_dir="/Applications"
  fi
  if [[ ! -w "$dest_dir" ]]; then
    warn "$dest_dir is not writable — falling back to ~/Applications"
    dest_dir="$HOME/Applications"
    mkdir -p "$dest_dir"
  fi
  dest_app="$dest_dir/$app_name"

  if [[ -n "$old_app" && "$old_app" != "$dest_app" && -d "$old_app" ]]; then
    info "Product name changed — removing stale $old_app"
    rm -rf "$old_app"
  fi

  # ── Install ───────────────────────────────────────────────
  printf "\n"
  spin_start "Quitting Revv…"
  osascript -e 'tell application "Revv" to quit' 2>/dev/null || true
  osascript -e 'tell application "Revv (Alpha)" to quit' 2>/dev/null || true
  sleep 1
  spin_stop 1

  spin_start "Installing ${app_name}…"
  rm -rf "$dest_app"
  cp -R "$bundle_app" "$dest_app"
  xattr -cr "$dest_app" 2>/dev/null || true
  spin_stop 1

  # Re-source common.sh from the freshly-pulled tree so we pick up any new
  # helpers that didn't exist in the version this revv CLI started with.
  if [[ -f "$INSTALL_DIR/scripts/lib/common.sh" ]]; then
    unset __REVV_COMMON_LOADED__
    # shellcheck disable=SC1091
    source "$INSTALL_DIR/scripts/lib/common.sh"
  fi

  # ── LaunchAgent ───────────────────────────────────────────
  local bun_for_plist
  bun_for_plist="$(command -v bun || true)"
  [[ -x "$bun_for_plist" ]] || fail "Cannot locate bun for the LaunchAgent."

  if declare -F write_launch_agent_plist >/dev/null 2>&1; then
    local _github_conf="${REVV_SUPPORT_DIR}/github.conf"
    if [[ -z "${REVV_GITHUB_HOST:-}" ]] && declare -F _revv_dotenv_get >/dev/null 2>&1; then
      REVV_GITHUB_HOST="$(_revv_dotenv_get GITHUB_HOST "$_github_conf")"
    fi
    if [[ -z "${REVV_GITHUB_CLIENT_ID:-}" ]] && declare -F _revv_dotenv_get >/dev/null 2>&1; then
      REVV_GITHUB_CLIENT_ID="$(_revv_dotenv_get GITHUB_CLIENT_ID "$_github_conf")"
    fi
    export REVV_GITHUB_HOST="${REVV_GITHUB_HOST:-}"
    export REVV_GITHUB_CLIENT_ID="${REVV_GITHUB_CLIENT_ID:-}"
    spin_start "Refreshing LaunchAgent…"
    launchctl unload "$LAUNCH_AGENT_PLIST" 2>/dev/null || true
    # write_launch_agent_plist calls info/success — redirect to suppress mid-spinner noise
    write_launch_agent_plist \
      "$LAUNCH_AGENT_PLIST" \
      "$bun_for_plist" \
      "$INSTALL_DIR" \
      "$LOG_DIR" >/dev/null 2>&1
    launchctl load -w "$LAUNCH_AGENT_PLIST" 2>/dev/null || true
    spin_stop 1
  else
    warn "write_launch_agent_plist not found in common.sh; keeping existing plist"
    spin_start "Reloading server…"
    launchctl unload "$LAUNCH_AGENT_PLIST" 2>/dev/null || true
    launchctl load -w "$LAUNCH_AGENT_PLIST" 2>/dev/null || true
    spin_stop 1
  fi

  # Refresh the CLI itself + helper lib in case they changed upstream.
  if [[ -f "$INSTALL_DIR/scripts/revv" ]]; then
    cp "$INSTALL_DIR/scripts/revv" "$CLI_PATH"
    chmod +x "$CLI_PATH"
  fi
  if [[ -f "$INSTALL_DIR/scripts/lib/common.sh" ]]; then
    mkdir -p "$HOME/.local/share/revv"
    cp "$INSTALL_DIR/scripts/lib/common.sh" "$HOME/.local/share/revv/common.sh"
  fi

  local short_head
  short_head="$(git -C "$INSTALL_DIR" rev-parse --short HEAD)"
  printf "\n"
  printf "  %s──────────────────────────────────────────────────────%s\n\n" "$DIM" "$RESET"
  printf "  %s%s✓  Revv is up to date!%s\n\n" "$GREEN" "$BOLD" "$RESET"
  printf "  %s▸%s  Version  %s%s%s\n\n" "$DIM" "$RESET" "$BOLD" "$short_head" "$RESET"
  printf "  %s──────────────────────────────────────────────────────%s\n\n" "$DIM" "$RESET"
  open "$dest_app" || true
}

cmd_channel() {
  if [[ $# -eq 0 ]]; then
    local current
    current="$(read_channel)"
    printf "%s\n" "$current"
    return 0
  fi
  local target="$1"
  case "$target" in
    stable|nightly) ;;
    -h|--help|help)
      cat <<EOF
${BOLD}revv channel${RESET} — print or change the release channel.

${BOLD}Usage:${RESET}
  revv channel               Print the current channel.
  revv channel stable        Switch to vetted releases (48h notification buffer).
  revv channel nightly       Switch to every push to main (notify instantly).
EOF
      return 0
      ;;
    *)
      fail "Unknown channel: $target (expected stable|nightly)"
      ;;
  esac
  step "Switching channel to ${target}"
  write_channel "$target"
  success "Channel is now ${target}."
  info "Next 'revv update' will pull the latest ${target} build."
}

cmd_uninstall() {
  step "Uninstall Revv"

  # ── Collect all artifact paths ──────────────────────────────
  local revv_data_dir="$HOME/.revv"
  local tauri_id="com.revv.desktop"
  local tauri_autostart_plist="$HOME/Library/LaunchAgents/${tauri_id}.plist"
  local tauri_webkit_dir="$HOME/Library/WebKit/$tauri_id"
  local tauri_app_support="$HOME/Library/Application Support/$tauri_id"
  local tauri_saved_state="$HOME/Library/Saved Application State/${tauri_id}.savedState"
  local tauri_caches="$HOME/Library/Caches/$tauri_id"
  local tauri_http_caches="$HOME/Library/Caches/${tauri_id}.WebView"
  local tauri_preferences="$HOME/Library/Preferences/${tauri_id}.plist"

  # The production database lives in the server CWD (= INSTALL_DIR for prod installs).
  local prod_db="$INSTALL_DIR/revv.db"
  local prod_db_wal="$INSTALL_DIR/revv.db-wal"
  local prod_db_shm="$INSTALL_DIR/revv.db-shm"

  cat <<EOF

${BOLD}This will permanently remove ALL Revv artifacts:${RESET}

  ${CYAN}Application${RESET}
    • Revv.app (all copies in /Applications and ~/Applications)

  ${CYAN}Background services${RESET}
    • $LAUNCH_AGENT_PLIST  (server LaunchAgent)
    • $tauri_autostart_plist  (desktop autostart)

  ${CYAN}Data${RESET}
    • $prod_db  (database + WAL/SHM)
    • $revv_data_dir/  (git clones, worktrees, settings)

  ${CYAN}Configuration${RESET}
    • $REVV_SUPPORT_DIR/  (auth key, config, github.conf, source tree)
    • $LOG_DIR/  (server logs)

  ${CYAN}Tauri / WebView data${RESET}
    • $tauri_webkit_dir/
    • $tauri_app_support/
    • $tauri_saved_state/
    • $tauri_caches/
    • $tauri_preferences

  ${CYAN}CLI${RESET}
    • $CLI_PATH
    • $HOME/.local/share/revv/

  ${CYAN}Shell config${RESET}
    • PATH entry added by the installer (in ~/.zshrc or ~/.bashrc)

  ${CYAN}OS registrations${RESET}
    • revv:// URL scheme (Launch Services)
EOF

  confirm "Proceed with uninstall?" || { info "Aborted."; return 0; }

  # ── 1. Stop services ────────────────────────────────────────
  info "Stopping services…"
  launchctl unload -w "$LAUNCH_AGENT_PLIST" 2>/dev/null || true
  launchctl unload -w "$tauri_autostart_plist" 2>/dev/null || true

  # Quit the app (try both product names)
  osascript -e 'tell application "Revv" to quit' 2>/dev/null || true
  osascript -e 'tell application "Revv (Alpha)" to quit' 2>/dev/null || true
  sleep 1

  # ── 2. Unregister revv:// URL scheme ────────────────────────
  # Removing the .app deletes the Info.plist that declares the scheme, but the
  # OS Launch Services database caches it. Explicitly unregister so macOS
  # forgets the revv:// handler immediately.
  local lsregister="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"
  if [[ -x "$lsregister" ]]; then
    for p in "${APP_CANDIDATES[@]}"; do
      [[ -d "$p" ]] && "$lsregister" -u "$p" 2>/dev/null || true
    done
    info "Unregistered revv:// URL scheme from Launch Services"
  fi

  # ── 3. Remove the .app bundle(s) ────────────────────────────
  for p in "${APP_CANDIDATES[@]}"; do
    if [[ -d "$p" ]]; then
      rm -rf "$p"
      info "Removed $p"
    fi
  done

  # ── 4. Remove LaunchAgents ──────────────────────────────────
  rm -f "$LAUNCH_AGENT_PLIST"
  rm -f "$tauri_autostart_plist"

  # ── 5. Remove database files ────────────────────────────────
  # Production DB (lives in server CWD = INSTALL_DIR for prod installs)
  for f in "$prod_db" "$prod_db_wal" "$prod_db_shm"; do
    [[ -f "$f" ]] && rm -f "$f"
  done
  # Also check repo root (some installs run from there)
  for f in "./revv.db" "./revv.db-wal" "./revv.db-shm"; do
    [[ -f "$f" ]] && rm -f "$f"
  done

  # ── 6. Remove ~/.revv/ (repos, worktrees, settings) ────────
  if [[ -d "$revv_data_dir" ]]; then
    rm -rf "$revv_data_dir"
    info "Removed $revv_data_dir (git clones, settings)"
  fi

  # ── 7. Remove ~/Library/Application Support/Revv/ ──────────
  # Contains: auth.key, config, github.conf, src/ (source install)
  if [[ -d "$REVV_SUPPORT_DIR" ]]; then
    rm -rf "$REVV_SUPPORT_DIR"
    info "Removed $REVV_SUPPORT_DIR"
  fi
  # Also remove source dir if it was overridden to a different location
  if [[ -d "$INSTALL_DIR" && "$INSTALL_DIR" != "$REVV_SUPPORT_DIR"* ]]; then
    rm -rf "$INSTALL_DIR"
    info "Removed $INSTALL_DIR"
  fi

  # ── 8. Remove logs ──────────────────────────────────────────
  [[ -d "$LOG_DIR" ]] && rm -rf "$LOG_DIR"

  # ── 9. Remove Tauri / WebView data ─────────────────────────
  for d in "$tauri_webkit_dir" "$tauri_app_support" "$tauri_saved_state" "$tauri_caches" "$tauri_http_caches"; do
    [[ -d "$d" ]] && rm -rf "$d" && info "Removed $d"
  done
  [[ -f "$tauri_preferences" ]] && rm -f "$tauri_preferences"

  # ── 10. Clean shell RC PATH entry ───────────────────────────
  local shell_rc=""
  case "${SHELL##*/}" in
    zsh)  shell_rc="$HOME/.zshrc" ;;
    bash) shell_rc="$HOME/.bashrc" ;;
  esac
  if [[ -n "$shell_rc" && -f "$shell_rc" ]]; then
    # Remove the "# Added by Revv installer" comment and the PATH line that follows it.
    # Also remove any standalone .local/bin PATH line that references the revv install.
    local tmp_rc
    tmp_rc="$(mktemp)"
    # Use a state machine: skip the comment line AND the next line if it's the PATH export.
    awk '
      /^# Added by Revv installer/ { skip=1; next }
      skip && /export PATH=.*\.local\/bin/ { skip=0; next }
      { skip=0; print }
    ' "$shell_rc" > "$tmp_rc"
    if ! cmp -s "$shell_rc" "$tmp_rc"; then
      mv "$tmp_rc" "$shell_rc"
      info "Cleaned Revv PATH entry from $shell_rc"
    else
      rm -f "$tmp_rc"
    fi
  fi

  # ── 11. Remove CLI + shared helper ──────────────────────────
  rm -f "$HOME/.local/share/revv/common.sh"
  rmdir "$HOME/.local/share/revv" 2>/dev/null || true

  # Remove self — do this last so the script can finish executing.
  [[ -f "$CLI_PATH" ]] && rm -f "$CLI_PATH"

  printf "\n"
  success "Revv has been completely uninstalled."
  info "Bun and the Rust toolchain were left installed — remove them manually if no longer needed."
  info "  bun:   rm -rf ~/.bun"
  info "  rust:  rustup self uninstall"
}

cmd_doctor() {
  step "Revv doctor"
  local issues=0
  bump() { issues=$((issues + 1)); }

  if [[ -d "$INSTALL_DIR/.git" ]]; then success "Source tree present"; else warn "Source tree missing: $INSTALL_DIR"; bump; fi
  if find_app >/dev/null; then success "Revv.app installed: $(find_app)"; else warn "Revv.app not found"; bump; fi
  if [[ -f "$LAUNCH_AGENT_PLIST" ]]; then success "LaunchAgent installed"; else warn "LaunchAgent missing"; bump; fi
  if command -v bun >/dev/null 2>&1; then success "bun $(bun --version)"; else warn "bun not on PATH"; bump; fi
  if command -v cargo >/dev/null 2>&1; then success "cargo $(cargo --version | awk '{print $2}')"; else warn "cargo not on PATH"; bump; fi
  if server_running; then success "API server responding on $API_URL"; else warn "API server not responding — try 'revv restart'"; bump; fi

  # Auth key check — replaces the old .env check. The server auto-generates
  # this on first start, so its presence + 0600 mode is what we verify.
  if [[ -f "$REVV_AUTH_KEY" ]]; then
    local mode
    # `stat -f` on macOS/BSD, `stat -c` on GNU. Try both.
    mode="$(stat -f '%Lp' "$REVV_AUTH_KEY" 2>/dev/null || stat -c '%a' "$REVV_AUTH_KEY" 2>/dev/null || echo '?')"
    if [[ "$mode" == "600" ]]; then
      success "Auth key present (mode 600)"
    else
      warn "Auth key exists but permissions are $mode — expected 600. Fix with: chmod 600 '$REVV_AUTH_KEY'"
      bump
    fi
  else
    warn "Auth key missing at $REVV_AUTH_KEY — server will create it on next start"
    bump
  fi

  printf "\n"
  if [[ $issues -eq 0 ]]; then
    printf "%s%s  ✓  All checks passed%s\n" "$BOLD" "$GREEN" "$RESET"
  else
    printf "%s%s  ✗  %d issue(s) found%s\n" "$BOLD" "$YELLOW" "$issues" "$RESET"
    return 1
  fi
}

# ── Dispatch ─────────────────────────────────────────────────
case "${1:-help}" in
  update)     shift; cmd_update "$@" ;;
  channel)    shift; cmd_channel "$@" ;;
  uninstall)  cmd_uninstall ;;
  start)      cmd_start ;;
  stop)       cmd_stop ;;
  restart)    cmd_restart ;;
  status)     cmd_status ;;
  logs)       cmd_logs ;;
  open)       cmd_open ;;
  doctor)     cmd_doctor ;;
  path)       cmd_path ;;
  help|-h|--help) cmd_help ;;
  *)
    printf "Unknown command: %s\n\n" "$1" >&2
    cmd_help
    exit 2
    ;;
esac
