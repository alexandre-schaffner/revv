#!/usr/bin/env bash
# Revv @@REVV_VERSION@@ release installer.
#
# The generated release artifact verifies its own Sigstore attestation, sets
# REVV_RELEASE_TAG, then continues into the canonical root install.sh appended
# by scripts/release/build-installer.sh. One signed file owns the full flow.
set -euo pipefail

REVV_VERSION="@@REVV_VERSION@@"
RELEASE_TAG="@@RELEASE_TAG@@"
REPO="alexandre-schaffner/revv"
REVV_SKIP_VERIFY="${REVV_SKIP_VERIFY:-0}"

if [[ -t 1 ]]; then
  R=$'\033[0m'; B=$'\033[1m'; D=$'\033[2m'
  C=$'\033[36m'; Y=$'\033[33m'; RE=$'\033[31m'
else
  R=""; B=""; D=""; C=""; Y=""; RE=""
fi

info() { printf '  %s.%s  %s\n' "$C" "$R" "$*"; }
warn() { printf '  %s!%s  %s\n' "$Y" "$R" "$*" >&2; }
fail() { printf '\n  %sx%s  %s\n\n' "$RE" "$R" "$*" >&2; exit 1; }

sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    shasum -a 256 "$1" | awk '{print $1}'
  fi
}

download_cosign() {
  local dir="$1" version="v2.4.3" url sha_url expected actual bin
  bin="$dir/cosign"

  case "$(uname -s)-$(uname -m)" in
    Linux-x86_64)
      url="https://github.com/sigstore/cosign/releases/download/${version}/cosign-linux-amd64"
      sha_url="https://github.com/sigstore/cosign/releases/download/${version}/cosign-linux-amd64.sha256"
      ;;
    Darwin-arm64)
      url="https://github.com/sigstore/cosign/releases/download/${version}/cosign-darwin-arm64"
      sha_url="https://github.com/sigstore/cosign/releases/download/${version}/cosign-darwin-arm64.sha256"
      ;;
    Darwin-x86_64)
      url="https://github.com/sigstore/cosign/releases/download/${version}/cosign-darwin-amd64"
      sha_url="https://github.com/sigstore/cosign/releases/download/${version}/cosign-darwin-amd64.sha256"
      ;;
    *) return 1 ;;
  esac

  info "gh CLI not found; bootstrapping cosign ${version}" >&2
  curl -fsSL "$url" -o "$bin"
  chmod +x "$bin"
  expected="$(curl -fsSL "$sha_url" | awk '{print $1}')"
  actual="$(sha256_of "$bin")"
  [[ "$actual" == "$expected" ]] || fail "cosign checksum mismatch."
  printf '%s' "$bin"
}

verify_attestation() {
  local script_path="$1" bundle cosign_dir cosign_bin

  if [[ "${SKIP_VERIFY_FLAG:-0}" == "1" && "$REVV_SKIP_VERIFY" == "1" ]]; then
    warn "Attestation skipped (--skip-verify + REVV_SKIP_VERIFY=1)."
    return 0
  fi

  bundle="$(mktemp).jsonl"
  curl -fsSL "https://github.com/${REPO}/releases/download/${RELEASE_TAG}/install.sh.sigstore" -o "$bundle" \
    || { rm -f "$bundle"; fail "Could not fetch installer attestation bundle."; }

  if command -v gh >/dev/null 2>&1; then
    info "Verifying installer attestation with gh"
    gh attestation verify "$script_path" --repo "$REPO" --bundle "$bundle" >/dev/null \
      || { rm -f "$bundle"; fail "Installer attestation verification failed."; }
    rm -f "$bundle"
    return 0
  fi

  cosign_dir="$(mktemp -d)"
  cosign_bin="$(download_cosign "$cosign_dir")" \
    || { rm -rf "$cosign_dir"; rm -f "$bundle"; fail "Cannot verify installer without gh or a supported cosign bootstrap."; }

  info "Verifying installer attestation with cosign"
  "$cosign_bin" verify-blob \
    --bundle "$bundle" \
    --certificate-identity-regexp "^https://github.com/${REPO}/" \
    --certificate-oidc-issuer "https://token.actions.githubusercontent.com" \
    "$script_path" >/dev/null \
    || { rm -rf "$cosign_dir"; rm -f "$bundle"; fail "Installer attestation verification failed."; }

  rm -rf "$cosign_dir"
  rm -f "$bundle"
}

printf '\n'
printf '  %s%sRevv%s  %srelease installer%s  %sv%s%s\n' "$C" "$B" "$R" "$D" "$R" "$B" "$REVV_VERSION" "$R"
printf '  %sRelease:%s %s%s%s\n\n' "$D" "$R" "$B" "$RELEASE_TAG" "$R"

SKIP_VERIFY_FLAG=0
INSTALLER_ARGS=()
for arg in "$@"; do
  case "$arg" in
    --skip-verify) SKIP_VERIFY_FLAG=1 ;;
    *) INSTALLER_ARGS+=("$arg") ;;
  esac
done

if [[ $# -eq 0 || ( " $* " != *" --help "* && " $* " != *" -h "* ) ]]; then
  SELF_PATH=""
  if [[ -n "${BASH_SOURCE[0]:-}" \
     && "${BASH_SOURCE[0]}" != "bash" \
     && "${BASH_SOURCE[0]}" != "/bin/bash" \
     && "${BASH_SOURCE[0]}" != /dev/fd/* \
     && -f "${BASH_SOURCE[0]}" ]]; then
    SELF_PATH="${BASH_SOURCE[0]}"
    verify_attestation "$SELF_PATH"
  else
    SELF_PATH="$(mktemp)"
    curl -fsSL "https://github.com/${REPO}/releases/download/${RELEASE_TAG}/install.sh" -o "$SELF_PATH" \
      || fail "Could not fetch installer copy for attestation."

    verify_attestation "$SELF_PATH"

    rc=0
    if [[ "$SKIP_VERIFY_FLAG" == "1" ]]; then
      bash "$SELF_PATH" --skip-verify "${INSTALLER_ARGS[@]}" || rc=$?
    else
      bash "$SELF_PATH" "${INSTALLER_ARGS[@]}" || rc=$?
    fi
    rm -f "$SELF_PATH"
    exit "$rc"
  fi
fi

export REVV_RELEASE_TAG="${REVV_RELEASE_TAG:-$RELEASE_TAG}"
set -- "${INSTALLER_ARGS[@]}"

# The canonical root install.sh is appended below at release build time.
