#!/usr/bin/env bash
# Revv @@REVV_VERSION@@ release installer.
#
# The generated release artifact verifies its own Sigstore attestation, sets
# REVV_RELEASE_TAG, then continues into the canonical root install.sh appended
# by scripts/release/build-installer.sh. One signed file owns the full flow.
set -euo pipefail

REVV_VERSION="@@REVV_VERSION@@"
RELEASE_TAG="@@RELEASE_TAG@@"
REPO="alexandre-schaffner/revv"
REVV_SKIP_VERIFY="${REVV_SKIP_VERIFY:-0}"

if [[ -t 1 ]]; then
  R=$'\033[0m'; B=$'\033[1m'; D=$'\033[2m'
  C=$'\033[36m'; Y=$'\033[33m'; RE=$'\033[31m'
else
  R=""; B=""; D=""; C=""; Y=""; RE=""
fi

info() { printf '  %s.%s  %s\n' "$C" "$R" "$*"; }
warn() { printf '  %s!%s  %s\n' "$Y" "$R" "$*" >&2; }
fail() { printf '\n  %sx%s  %s\n\n' "$RE" "$R" "$*" >&2; exit 1; }

sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    shasum -a 256 "$1" | awk '{print $1}'
  fi
}

download_gh() {
  local dir="$1" version="2.103.3" arch expected actual archive stem bin
  case "$(uname -s)-$(uname -m)" in
    Darwin-arm64)
      arch="arm64"
      expected="d700207eae9ae98fe2b89535c2c087c07823d4628c56364695a5a07ef311c062"
      ;;
    Darwin-x86_64)
      arch="amd64"
      expected="a2f86418f4350ae6e9ec60d5000bdf7665728436946a97fc27fe50e6ae752682"
      ;;
    *) fail "Revv's installer requires macOS on Apple Silicon or Intel." ;;
  esac
  stem="gh_${version}_macOS_${arch}"
  archive="$dir/gh.zip"
  bin="$dir/gh"

  info "Downloading temporary GitHub CLI v${version} for verification" >&2
  curl -fsSL "https://github.com/cli/cli/releases/download/v${version}/${stem}.zip" -o "$archive" \
    || fail "Could not download GitHub CLI for installer verification. Check your connection to github.com and retry."
  # Pin the archive digest here so it is checked before any downloaded code runs.
  actual="$(sha256_of "$archive")" || fail "Could not checksum GitHub CLI."
  [[ "$actual" == "$expected" ]] || fail "GitHub CLI checksum mismatch."
  unzip -p "$archive" "$stem/bin/gh" > "$bin" \
    || fail "Could not extract GitHub CLI for installer verification."
  chmod +x "$bin" || fail "Could not make GitHub CLI executable."
  printf '%s' "$bin"
}

verify_attestation() (
  local script_path="$1" workdir bundle gh_bin

  if [[ "${SKIP_VERIFY_FLAG:-0}" == "1" && "$REVV_SKIP_VERIFY" == "1" ]]; then
    warn "Attestation skipped (--skip-verify + REVV_SKIP_VERIFY=1)."
    return 0
  fi

  workdir="$(mktemp -d)" || fail "Could not create installer verification directory."
  trap 'rm -rf "$workdir"' EXIT
  bundle="$workdir/install.jsonl"
  curl -fsSL "https://github.com/${REPO}/releases/download/${RELEASE_TAG}/install.sh.sigstore" -o "$bundle" \
    || fail "Could not fetch installer attestation bundle."

  if command -v gh >/dev/null 2>&1; then
    gh_bin="$(command -v gh)"
  else
    gh_bin="$(download_gh "$workdir")" || exit 1
  fi

  info "Verifying installer attestation with gh"
  GH_CONFIG_DIR="$workdir/config" XDG_CACHE_HOME="$workdir/cache" \
    "$gh_bin" attestation verify "$script_path" --hostname github.com --repo "$REPO" --bundle "$bundle" >/dev/null \
    || fail "Installer attestation verification failed. See the verifier error above; installation has stopped."
)

if [[ -z "${REVV_PREFLIGHT_DONE:-}" ]]; then
  printf '\n'
  printf '  %s%sRevv%s  %srelease installer%s  %sv%s%s\n' "$C" "$B" "$R" "$D" "$R" "$B" "$REVV_VERSION" "$R"
  printf '  %sRelease:%s %s%s%s\n\n' "$D" "$R" "$B" "$RELEASE_TAG" "$R"
fi

SKIP_VERIFY_FLAG=0
INSTALLER_ARGS=()
for arg in "$@"; do
  case "$arg" in
    --skip-verify) SKIP_VERIFY_FLAG=1 ;;
    *) INSTALLER_ARGS+=("$arg") ;;
  esac
done

if [[ $# -eq 0 || ( " $* " != *" --help "* && " $* " != *" -h "* ) ]]; then
  SELF_PATH=""
  if [[ -n "${BASH_SOURCE[0]:-}" \
     && "${BASH_SOURCE[0]}" != "bash" \
     && "${BASH_SOURCE[0]}" != "/bin/bash" \
     && "${BASH_SOURCE[0]}" != /dev/fd/* \
     && -f "${BASH_SOURCE[0]}" ]]; then
    SELF_PATH="${BASH_SOURCE[0]}"
    verify_attestation "$SELF_PATH"
  else
    SELF_PATH="$(mktemp)"
    curl -fsSL "https://github.com/${REPO}/releases/download/${RELEASE_TAG}/install.sh" -o "$SELF_PATH" \
      || fail "Could not fetch installer copy for attestation."

    verify_attestation "$SELF_PATH"

    rc=0
    if [[ "$SKIP_VERIFY_FLAG" == "1" ]]; then
      REVV_PREFLIGHT_DONE=1 REVV_SKIP_BANNER=1 bash "$SELF_PATH" --skip-verify "${INSTALLER_ARGS[@]+"${INSTALLER_ARGS[@]}"}" || rc=$?
    else
      REVV_PREFLIGHT_DONE=1 REVV_SKIP_BANNER=1 bash "$SELF_PATH" "${INSTALLER_ARGS[@]+"${INSTALLER_ARGS[@]}"}" || rc=$?
    fi
    rm -f "$SELF_PATH"
    exit "$rc"
  fi
fi

export REVV_RELEASE_TAG="${REVV_RELEASE_TAG:-$RELEASE_TAG}"
set -- "${INSTALLER_ARGS[@]+"${INSTALLER_ARGS[@]}"}"

# The canonical root install.sh is appended below at release build time.
